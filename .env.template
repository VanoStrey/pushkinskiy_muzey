# Скопируйте в .env: `cp .env.template .env`. Файл .env не коммитится.
#
# Здесь только переменные для локального запуска (docker compose).
# В облаке ничего вписывать не нужно: CI сам находит каталог, YDB и прочие ресурсы
# и передаёт бэкенду (Cloud Function) нужные переменные окружения.
#
# Где живёт каждая переменная:
#   [локально] — только в вашем .env, для docker compose
#   [функция]  — переменная окружения Cloud Function, её выставляет CI
#
# Локальные значения уже заполнены: после копирования всё работает без правок.
# Не вписывайте сюда реальные ключи, если собираетесь коммитить этот файл.
# Секреты для облака храните в SourceCraft: Настройки репозитория → Секреты
# (см. README, раздел «Свои переменные окружения»).

# ---------- Приложение ----------
# [локально] Название приложения (заголовок документации API на /api/docs). Необязательно.
APP_NAME=hackathon-template

# ---------- YDB ----------
# [локально] локальная YDB из docker compose
# [функция] в облаке CI подставляет адрес базы YDB Serverless, которую создаёт сам
YDB_ENDPOINT=grpc://ydb:2136
YDB_DATABASE=/local
# [локально] анонимный доступ к локальной YDB.
# В облаке вместо него YDB_METADATA_CREDENTIALS=1 (сервисный аккаунт функции), его ставит CI.
YDB_ANONYMOUS_CREDENTIALS=1
# [локально] и [функция] Сколько секунд ждать подключения к YDB при старте (проверка идёт в фоне)
YDB_CONNECT_TIMEOUT=10

# ---------- AI Studio ----------
# Без YANDEX_FOLDER_ID всё работает, только /api/hello покажет «LLM is not configured».
#
# [локально] API-ключ для вызовов AI Studio с вашего компьютера. Используется только бэкендом.
#   Никогда не кладите его во фронтенд (в код frontend/ и в переменные VITE_*).
#   В облаке ключ не нужен: функция берёт IAM-токен своего сервисного аккаунта
#   из сервиса метаданных.
YANDEX_API_KEY=
# [локально] ID каталога для AI Studio.
# [функция] в облаке CI передаёт ID каталога из сервисного подключения.
YANDEX_FOLDER_ID=
# [локально] и [функция] Модель AI Studio, без префикса gpt://<folder_id>/.
#   Список моделей: https://yandex.cloud/ru/docs/ai-studio/concepts/generation/models
#   В облаке значение задаётся в env workflow deploy в .sourcecraft/ci.yaml.
YANDEX_MODEL=yandexgpt-5-lite/latest
