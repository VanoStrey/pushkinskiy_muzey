# Local development image only: runs the Vite dev server with src/ mounted from the host.
# The cloud serves the static build (`npm run build` -> dist/) from Object Storage instead.
FROM node:22.23.2-alpine

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

EXPOSE 5173
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
